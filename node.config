{
  "schemaVersion": "2.0",
  "name": "IncomeTracker",
  "slug": "incomeTracker",
  "type": "fastapi-app",
  "hostBase": "income-tracker.life.local",
  "inherits": "../Life/node.config",
  "taxonomy": {
    "id": "incomeTracker",
    "cluster": [
      "Finance"
    ],
    "displayName": "IncomeTracker",
    "commercial": false
  },
  "tooling": {},
  "capabilities": [],
  "agents": {
    "archetypes": []
  },
  "mcp": {
    "toolsets": []
  },
  "children": [],
  "deploy": {
    "backendPkg": "income_tracker_backend",
    "migrations": true,
    "database": {
      "name": "incometracker",
      "user": "incometracker",
      "host": "incometracker-db",
      "driver": "postgresql+asyncpg",
      "image": "postgres:16-alpine",
      "volume": "incometracker_incometracker_pgdata"
    }
  }
}
